# ignore dotfiles except .gitignore, .dockerignore, and selected .claude/ tooling
.*
!.gitignore
!.dockerignore
!.claude/
!.claude/settings.json
!.claude/commands/
!.claude/commands/*

# Keep the SDD layer (steering docs + feature specs) tracked
!.sdd/

# Keep personal Claude Code config out of the repo
.claude/settings.local.json

# Dependencies
node_modules/

# Build output
dist/

# Editors / OS / temp
*.swp

# Logs
*.log
npm-debug.log*

# Test coverage
coverage/
